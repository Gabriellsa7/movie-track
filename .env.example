PORT=3000
# Proxies in front of the app (1 on Render, Railway, Fly.io...); 0 when it is reached directly
TRUST_PROXY_HOPS=0
NODE_ENV=DEV

DATABASE_URI="mongodb://whitebeard:whitebeard@localhost/whitebeard"
MONGODB_DATABASE='whitebeard'

OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=node-boilerplate
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

BCRYPT_ROUNDS=10

JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloudinary (poster uploads): Settings > API Keys in the Cloudinary console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# TMDB (movie search): the "API Read Access Token" from themoviedb.org > Settings > API
TMDB_ACCESS_TOKEN=change-me

# Front-end URL: e-mail links point to its /verify-email and /reset-password pages
APP_URL=http://localhost:5173
# Browser origins allowed to call the API, comma-separated (defaults to APP_URL)
CORS_ORIGINS=http://localhost:5173
# Resend (e-mails): API key from resend.com > API Keys. Without it, e-mails are only
# logged (fine locally, never in production). onboarding@resend.dev works without a
# domain but only delivers to the address that owns the Resend account.
RESEND_API_KEY=
EMAIL_FROM=Movie Track <onboarding@resend.dev>
