PORT=3000
# Proxies in front of the app (1 on Render, Railway, Fly.io...); 0 when it is reached directly
TRUST_PROXY_HOPS=0
NODE_ENV=DEV

DATABASE_URI="mongodb://whitebeard:whitebeard@localhost/whitebeard"
MONGODB_DATABASE='whitebeard'

OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=node-boilerplate
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

BCRYPT_ROUNDS=10

JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloudinary (poster uploads, optional — without it uploads answer 503): Settings > API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# TMDB (movie search, optional — without it the search answers 503): "API Read Access Token" from themoviedb.org > Settings > API
TMDB_ACCESS_TOKEN=change-me

# Where the e-mail links point, followed by /verify-email or /reset-password (defaults to http://localhost:5173).
# For the mobile app, use this API's public URL plus /links (e.g. https://api.example.com/links):
# GET /links/{action} answers a page that opens the app.
APP_URL=http://localhost:5173
# The app address that page opens (defaults to movietrack://). In Expo Go use exp://<your-ip>:8081/--
APP_DEEP_LINK_URL=movietrack://
# Browser origins allowed to call the API, comma-separated (defaults to APP_URL)
CORS_ORIGINS=http://localhost:5173
# Resend (e-mails): API key from resend.com > API Keys. Without it, e-mails are only
# logged (fine locally, never in production). onboarding@resend.dev works without a
# domain but only delivers to the address that owns the Resend account.
RESEND_API_KEY=
EMAIL_FROM=Movie Track <onboarding@resend.dev>
